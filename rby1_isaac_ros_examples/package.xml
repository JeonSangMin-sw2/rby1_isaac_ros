<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rby1_isaac_ros_examples</name>
  <version>0.1.0</version>
  <description>Example launch files for the RBY1 Isaac ROS packages: what the container runs for one use, started with one command</description>
  <maintainer email="rainbow@rainbow-robotics.com">Rainbow Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rby1_apriltag</exec_depend>
  <exec_depend>rby1_cumotion</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
