# Copy this to ~/.isaac_ros_common-config, then build and enter the container the
# usual way with isaac_ros_common/scripts/run_dev.sh. One image, one container:
# the cuMotion layer is appended to the official chain rather than forked from it.
#
#   cp docker/isaac_ros_common-config ~/.isaac_ros_common-config
#
# No realsense layer: cameras run on the host (rby1_additional_tools) and only their
# topics reach the container. That layer source-builds librealsense (1.5 GB, and
# long on a Jetson) for nothing here.
CONFIG_IMAGE_KEY=ros2_humble.cumotion
# Relative to isaac_ros_common/scripts (build_image_layers.sh resolves it there), so
# it holds wherever the workspace is, as long as both repositories sit side by side in src/.
CONFIG_DOCKER_SEARCH_DIRS=("../../rby1_isaac_ros/docker")
